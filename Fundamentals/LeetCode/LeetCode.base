filters:
  and:
    - "!leetcode.isEmpty()"
properties:
  note.leetcode:
    displayName: 题目
  file.name:
    displayName: 题解
  note.difficulties:
    displayName: 难度
  note.link:
    displayName: 链接
views:
  - type: table
    name: 全部题目
    order:
      - leetcode
      - file.name
      - difficulties
      - link
    sort:
      - property: leetcode
        direction: ASC
    columnSize:
      note.leetcode: 169
      file.name: 221
      note.difficulties: 143
  - type: table
    name: 简单题目
    filters:
      and:
        - difficulties == "EASY"
    order:
      - leetcode
      - file.name
      - difficulties
      - link
    sort:
      - property: leetcode
        direction: ASC
  - type: table
    name: 中等题目
    filters:
      and:
        - difficulties == "MEDIUM"
    order:
      - leetcode
      - file.name
      - difficulties
      - link
    sort:
      - property: leetcode
        direction: ASC
  - type: table
    name: 困难题目
    filters:
      and:
        - difficulties == "HARD"
    order:
      - leetcode
      - file.name
      - difficulties
      - link
    sort:
      - property: leetcode
        direction: ASC
